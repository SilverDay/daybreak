# Copy to config/.env (NEVER commit). Lives above the Apache DocumentRoot.
APP_ENV=production
APP_DEBUG=false
APP_BASE_URL=https://daybreak.silverday.de
APP_KEY=change-me-32-byte-random

# Database (least-priv application user)
DB_DSN=mysql:host=127.0.0.1;dbname=daybreak;charset=utf8mb4
DB_USER=daybreak_app
DB_PASS=change-me

# Fetcher
FETCH_USER_AGENT=Mozilla/5.0 (compatible; DaybreakAggregator/0.1; +https://daybreak.silverday.de)

# ransomlook API (public, no key required)
RANSOMLOOK_API=https://www.ransomlook.io/api

# Mail (SMTP). If SMTP_HOST is empty, MailService falls back to PHP mail().
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=daybreak@silverday.de
SMTP_FROM_NAME=Daybreak

# Maintenance prune retention (days)
PRUNE_ARTICLES_DAYS=90
PRUNE_FETCHLOG_DAYS=30
PRUNE_ATTEMPTS_DAYS=30
