# Copy to config/.env (NEVER commit). Lives above the Apache DocumentRoot.
APP_ENV=production
APP_DEBUG=false
APP_BASE_URL=https://daybreak.silverday.de
APP_KEY=change-me-32-byte-random

# Database (least-priv application user)
DB_DSN=mysql:host=127.0.0.1;dbname=daybreak;charset=utf8mb4
DB_USER=daybreak_app
DB_PASS=change-me

# Fetcher
FETCH_USER_AGENT=Mozilla/5.0 (compatible; DaybreakAggregator/0.9; +https://daybreak.silverday.de)

# NVD CVE API key (free — register at https://nvd.nist.gov/developers/request-an-api-key)
# Without a key, unauthenticated requests are aggressively rate-limited (503 under load).
NVD_API_KEY=

# GitHub Advisory Database token (optional — increases rate limit from 60 to 5000 req/hr)
# Any PAT or fine-grained token works; no scopes required for public advisory data.
# GITHUB_TOKEN=

# ransomlook API (public, no key required)
RANSOMLOOK_API=https://www.ransomlook.io/api

# Admin notification email. If set, an email is sent to this address whenever
# a new user registers or a source suggestion is submitted. Leave blank to disable.
ADMIN_NOTIFY_EMAIL=

# Mail (SMTP). If SMTP_HOST is empty, MailService falls back to PHP mail().
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=daybreak@silverday.de
SMTP_FROM_NAME=Daybreak

# Maintenance prune retention (days)
PRUNE_ARTICLES_DAYS=90
PRUNE_FETCHLOG_DAYS=30
PRUNE_ATTEMPTS_DAYS=30
PRUNE_AUDIT_DAYS=365
PRUNE_WEBHOOK_DAYS=90
